{
  "name": "pard_only",
  "source_preset": "F1P_formal_pard_only",
  "model": {
    "input_channels": 3,
    "num_classes": 1,
    "depths": [2, 2, 2, 2],
    "depths_decoder": [2, 2, 2, 1],
    "drop_path_rate": 0.2,
    "use_mdk": false,
    "use_pard": true,
    "mdk_stages": [0, 1, 2, 3],
    "mdk_kernels": [1, 3, 5],
    "use_dilated_kernel": false,
    "dilated_kernel_dilation": 2,
    "mdk_expansion": 2,
    "init_gamma": 0.001,
    "pard_stages": [0, 1, 2, 3],
    "pard_feature_hidden_ratio": 0.25,
    "pard_prediction_hidden_ratio": 0.5,
    "pard_feature_epsilon": 0.1,
    "pard_prediction_epsilon": 0.1,
    "pard_alpha_init": 0.001,
    "pard_alpha_bound": 1.0,
    "pard_delta_max": 2.0,
    "pard_eta_init": 0.1,
    "pard_detach_ambiguity": true,
    "pard_ambiguity_temperature": 1.0,
    "pard_use_feature_refinement": true,
    "pard_use_logit_refinement": true
  },
  "training": {
    "input_size": [256, 256],
    "seed": 42,
    "split_seed": 42,
    "batch_size": 16,
    "epochs": 300,
    "num_workers": 0,
    "backbone_lr": 0.0005,
    "new_module_lr": 0.001,
    "betas": [0.9, 0.999],
    "eps": 1e-8,
    "weight_decay": 0.01,
    "amsgrad": false,
    "t_max": 50,
    "eta_min": 0.00001,
    "grad_clip_norm": 1.0,
    "threshold": 0.5,
    "lambda_aux": 0.4,
    "aux_weights": [0.1, 0.2, 0.3, 0.4]
  }
}
